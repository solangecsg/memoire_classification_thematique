# Copier ce fichier en ".env" (dans ce même dossier config/) et renseigner
# une vraie clé API Mistral à la place du texte ci-dessous.
# Ce fichier .env.example est le seul suivi par git — .env lui-même est
# ignoré (voir .gitignore) et ne doit jamais être commité.

MISTRAL_API_KEY=mets-ta-cle-ici

# Optionnel — modèle à utiliser (défaut : mistral-large-latest si absent).
# Voir la table PRICING dans classification/classify_iptc_mistral_batched.py
# pour les modèles pris en charge par l'estimation de coût.
# MISTRAL_MODEL=mistral-large-latest
